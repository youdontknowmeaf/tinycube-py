from ursina import *
from ursina.prefabs.first_person_controller import FirstPersonController
#from dataclasses import dataclass

app = Ursina(title = 'TinyCube - Minecraft clone made by SpookScoop93')

app.sky = Sky(color=color.hex('#6EB1FF'), texture=None)

blocks = ['stone', 'grass']
selected_block = 0

class block(Entity):
    def __init__(self, position=(0,0,0), texture='grass'):
        super().__init__(parent=scene,
                         position=position,
                         model='cube',
                         origin_y=5,
                         texture=texture,
                         color=color.hsv(0, 0, random.uniform(.9, 1.0)),
                         collider='box'
                         )

# World
X_MAX:int = 16
Y_MAX:int = 6
Z_MAX:int = 16

def set_Y_block(y: int):
    global Y_MAX
    if y < Y_MAX-1:
        return 'stone'
    else:
        return 'grass'
        
world_dict = {}

for x in range(X_MAX):
    for z in range(Z_MAX):
        for y in range(Y_MAX):
            pos = (x, y, z)
            world_dict[pos] = block(position=(x,y,z),texture=set_Y_block(y))


help_text = Text(text='LMB - place, RMB - destroy, ESC - quit', origin=(0,0), scale=2, y=0.4)
invoke(setattr, help_text, 'enabled', False, delay=10)

def input(key):
    global selected_block
    if key == 'left mouse down':
        hit_info = raycast(camera.world_position, camera.forward, distance=5)
        if hit_info.hit:
            new_pos = hit_info.entity.position + hit_info.normal
            pos_key = (int(new_pos.x), int(new_pos.y), int(new_pos.z))
            if pos_key not in world_dict:
                world_dict[pos_key] = block(position=hit_info.entity.position + hit_info.normal, texture=blocks[selected_block])
    if key ==  'right mouse down' and mouse.hovered_entity:
        hit_info = raycast(camera.world_position, camera.forward, distance=5)
        if hit_info.hit:
            hit_entity = hit_info.entity
            for pos, ent in list(world_dict.items()):
                if ent == hit_entity:
                    del world_dict[pos]
                    break
            destroy(hit_entity)

    if key == 'escape':
        mouse.locked = not mouse.locked
    if key == '1':
        selected_block = 0
    if key == '2':
        selected_block = 1

player = FirstPersonController()

app.run()
